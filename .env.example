# Required for live resume parsing, CV improvement, grounded mentor,
# and Gemini-based semantic embeddings.
GEMINI_API_KEY=

# Gemini model used for generation.
GEMINI_MODEL=gemini-3.8-flash

# Current stable fallbacks for temporary availability/high-demand errors.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# Embedding provider:
# gemini-api = cloud semantic embeddings
# local-lsa  = offline TF-IDF + TruncatedSVD fallback
# fastembed  = optional local neural embedding backend
EMBEDDING_PROVIDER=gemini-api

# Dedicated Gemini embedding model.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Gemini embedding dimensionality.
GEMINI_EMBEDDING_DIMENSION=768

# Maximum number of texts sent to the embedding API/model at once.
EMBEDDING_BATCH_SIZE=64

# Local-LSA fallback settings.
EMBEDDING_MAX_FEATURES=4096
EMBEDDING_DIMENSION=128

# Optional neural embedding backend.
# Local, heavier — intended for local notebook comparisons, use with caution if deployed.
# EMBEDDING_PROVIDER=fastembed
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

TOP_K_JOBS=8
TOP_K_MENTOR=5
MENTOR_MIN_SCORE=0.28
# Optional evaluation override: maximum number of Gemini judge calls.
# Default: 8; increase only when API quota permits.
# SMARTHIRE_MAX_JUDGE_CALLS=8

# Optional evaluation override: run the before/after mentor prompt comparison.
# Default: true. Accepted true values: 1, true, yes, on.
# SMARTHIRE_RUN_PROMPT_COMPARISON=true
